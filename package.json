{
  "name": "dart-scorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:online": "node scripts/dev-online.mjs",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "build": "tsc -b && vite build",
    "build:online": "tsc -b && vite build --mode online",
    "build:server": "node scripts/build-server.mjs",
    "start": "node --enable-source-maps dist-server/index.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:responsive": "playwright test --project=standalone"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@vitejs/plugin-react": "latest",
    "hono": "^4.13.11",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "^1.62.1",
    "@types/node": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.2",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "tsx": "^4.23.15",
    "typescript-eslint": "latest",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
